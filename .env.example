# Which LLM provider to use: "anthropic" or "scripted" (offline fake, for demos/tests)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Folder that contains the repositories CodePilot is allowed to work on
PROJECTS_DIR=./examples

# SQLite by default; e.g. postgresql+psycopg://user:pass@localhost/codepilot for Postgres
DATABASE_URL=sqlite:///./codepilot.db

# Agent limits
AGENT_MAX_STEPS=25
COMMAND_TIMEOUT_SECONDS=120

LOG_LEVEL=INFO
