# LLM provider (currently: "anthropic")
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# low | medium | high | xhigh | max - lower is cheaper and faster, higher is more thorough
ANTHROPIC_EFFORT=high

# Folder that contains the repositories CodePilot is allowed to work on
PROJECTS_DIR=./examples

# SQLite by default; e.g. postgresql+psycopg://user:pass@localhost/codepilot for Postgres
DATABASE_URL=sqlite:///./codepilot.db

# Agent limits
AGENT_MAX_STEPS=25
COMMAND_TIMEOUT_SECONDS=120

LOG_LEVEL=INFO
