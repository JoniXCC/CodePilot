# LLM provider: "anthropic" (Claude API, paid) or "ollama" (local model, free)
LLM_PROVIDER=anthropic

# --- Anthropic ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# low | medium | high | xhigh | max - lower is cheaper and faster, higher is more thorough
ANTHROPIC_EFFORT=high

# --- Ollama (https://ollama.com) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b
# Context window in tokens; larger needs more GPU/RAM memory
OLLAMA_NUM_CTX=16384

# Folder containing the repositories CodePilot may work on (relative to the project root).
# `python -m app.demo` fills it with git copies of examples/.
PROJECTS_DIR=demo-projects

# Defaults to codepilot.db (SQLite) in the project root. For PostgreSQL, e.g.:
# DATABASE_URL=postgresql+psycopg://user:pass@localhost/codepilot

# Agent limits
AGENT_MAX_STEPS=25
COMMAND_TIMEOUT_SECONDS=120

LOG_LEVEL=INFO
